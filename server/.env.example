DB_PATH=./fashion.sqlite3
SECRET_KEY=change_me_in_production

# iOS アプリ（ios/FashionSwipe/Data）と同じ楽天商品データを、サーバー起動時にDBへ投入する
RAKUTEN_JSON_DIR=../ios/FashionSwipe/Data

# 嗜好文を生成するLLM: mock | ollama | gemini（mock ならLLMなしで動く）
LLM_PROVIDER=mock

# Ollama（ローカルLLM）を使う場合
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:26b-mxfp8

# Gemini を使う場合
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your_key_here

# 楽天APIから商品を取得する場合（python -m backend.ingest.seed）
# RAKUTEN_APP_ID=
# RAKUTEN_ACCESS_KEY=
# RAKUTEN_AFFILIATE_ID=
